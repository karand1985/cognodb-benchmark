<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.wexa</groupId>
    <artifactId>cognodb-benchmark</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Graph Database Cloud Benchmark</name>
    <description>
        Benchmarks CognoDB Cloud against Neo4j AuraDB, FalkorDB, Amazon Neptune,
        and TigerGraph Cloud on the SNAP soc-Pokec social network dataset.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions — pinned for reproducibility -->
        <neo4j.driver.version>5.18.0</neo4j.driver.version>
        <gremlin.driver.version>3.7.2</gremlin.driver.version>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <dotenv.version>3.0.0</dotenv.version>
        <jackson.version>2.17.1</jackson.version>
        <commons.csv.version>1.11.0</commons.csv.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
    </properties>

    <dependencies>

        <!-- ================================================================
             Graph DB Drivers
             ================================================================ -->

        <!-- Neo4j Java Driver — covers CognoDB Cloud, Neo4j AuraDB, FalkorDB
             All three speak the Bolt protocol; only URI + credentials change. -->
        <dependency>
            <groupId>org.neo4j.driver</groupId>
            <artifactId>neo4j-java-driver</artifactId>
            <version>${neo4j.driver.version}</version>
        </dependency>

        <!-- Apache TinkerPop Gremlin Driver — covers Amazon Neptune -->
        <dependency>
            <groupId>org.apache.tinkerpop</groupId>
            <artifactId>gremlin-driver</artifactId>
            <version>${gremlin.driver.version}</version>
        </dependency>

        <!-- TinkerPop Gremlin Language Variant for Java (fluent DSL) -->
        <dependency>
            <groupId>org.apache.tinkerpop</groupId>
            <artifactId>gremlin-core</artifactId>
            <version>${gremlin.driver.version}</version>
        </dependency>

        <!-- ================================================================
             Stats & Reporting
             ================================================================ -->

        <!-- HDRHistogram — industry-standard low-latency percentile tracking.
             Used to compute p50 / p95 for every latency workload. -->
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
        </dependency>

        <!-- Jackson — serialize BenchmarkResult objects to JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ================================================================
             Utilities
             ================================================================ -->

        <!-- dotenv-java — reads .env file into System properties locally;
             on CI / cloud the real env vars are used directly. -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- Apache Commons CSV — robust CSV parsing for the Pokec dataset -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons.csv.version}</version>
        </dependency>

        <!-- ================================================================
             Logging — SLF4J + Logback
             ================================================================ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Compiler plugin — enforce Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Shade plugin — builds a single executable fat JAR.
                 Run with: java -jar target/cognodb-benchmark-1.0.0.jar [args] -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.wexa.benchmark.Main</mainClass>
                                </transformer>
                                <!-- Merge META-INF/services for TinkerPop SPI -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
