# ============================================================
# .env.example — copy this to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# --- CognoDB Cloud -------------------------------------------
# bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=bolt+s://YOUR_INSTANCE_ID.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here

# --- Neo4j AuraDB Free ---------------------------------------
# neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_AURA_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=your_aura_password_here

# --- FalkorDB (self-hosted Docker) ---------------------------
# bolt://localhost:7687  (or your Docker host IP)
FALKORDB_URI=bolt://localhost:7687
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=

# --- Amazon Neptune ------------------------------------------
# your-cluster-id.cluster-xxxx.us-east-1.neptune.amazonaws.com
NEPTUNE_ENDPOINT=your-cluster.cluster-xxxx.us-east-1.neptune.amazonaws.com
NEPTUNE_PORT=8182

# --- ArangoDB (self-hosted Docker) ---------------------------
# Default: http://localhost:8529
ARANGODB_HOST=http://localhost:8529
ARANGODB_PASSWORD=benchmark123

# --- TigerGraph Cloud (OPTIONAL — excluded from --all runs) --
# Only needed if running: java -jar benchmark.jar --db tigergraph
# TIGERGRAPH_HOST=https://your-subdomain.i.tgcloud.io
# TIGERGRAPH_TOKEN=your_tigergraph_bearer_token_here
# TIGERGRAPH_GRAPH=PokecGraph

# --- Benchmark tuning (optional — defaults shown) ------------
BENCH_WARMUP_ITERATIONS=20
BENCH_MEASURE_ITERATIONS=100
BENCH_CONCURRENCY_LEVELS=1,10,40
BENCH_TRAVERSAL_START_NODES=100
